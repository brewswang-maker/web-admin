{
  "version": "2.0.0",
  "description": "华盾AI智能视频盒子 - 新工厂3D场景模型配置",

  "scene": {
    "background": "#1e2233",
    "fog": {
      "type": "FogExp2",
      "color": "#1e2233",
      "density": 0.003
    },
    "ground": {
      "width": 120,
      "height": 100,
      "color": "#2a3040",
      "roughness": 0.7,
      "metalness": 0.1
    },
    "grid": {
      "size": 120,
      "divisions": 30,
      "color1": "#2a3050",
      "color2": "#1e2538"
