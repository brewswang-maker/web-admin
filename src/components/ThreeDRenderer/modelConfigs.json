      { "x": 55,  "y": 0, "z": 0, "width": 0.3, "height": 3, "depth": 100 },
      { "x": 0,   "y": 0, "z": -48, "width": 110, "height": 3, "depth": 0.3 },
      { "x": 0,   "y": 0, "z": 48,  "width": 110, "height": 3, "depth": 0.3 }
    ]
  },

  "materials": {
    "building": {
      "opacity": 0.65,
      "roughness": 0.5,
      "metalness": 0.3,
      "emissiveIntensity": 0.1,
      "edgeOpacity": 0.8
    },
    "deviceBody": {
      "color": "#6a7585",
      "roughness": 0.4,
      "metalness": 0.5
