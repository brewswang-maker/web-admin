  "renderer": {
    "antialias": true,
    "alpha": true,
    "shadowMap": {
      "enabled": true,
      "type": "PCFShadowMap"
    },
    "pixelRatioCap": 2,
    "toneMapping": "ACESFilmic",
    "toneMappingExposure": 2.0
  },

  "lighting": {
    "ambient": {
      "color": "#99aabb",
      "intensity": 1.5
    },
    "hemisphere": {
      "skyColor": "#c8d8e8",
      "groundColor": "#444422",
      "intensity": 1.0
    },
    "directional": {
      "color": "#ffffff",
      "intensity": 3.0,
      "position": [30, 40, 20],
      "castShadow": true,
      "shadowMapSize": 2048,
      "shadowCamera": {
        "left": -60,
        "right": 60,
        "top": 60,
        "bottom": -60
      }
    },
    "point": {
      "color": "#ddeeff",
      "intensity": 1.2,
      "position": [0, 20, 0],
      "distance": 150
    }
  },

  "walls": {
    "color": "#2a3555",
    "opacity": 0.6,
    "edgeColor": "#4488cc",
    "edgeOpacity": 0.5,
