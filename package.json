{
  "name": "shieldai-web-admin",
  "version": "1.0.0",
  "description": "华盾AI智能视频盒子 - Web管理后台",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production vite build",
    "build:analyze": "ANALYZE=true NODE_ENV=production vite build",
    "build:full": "vue-tsc --noEmit && NODE_ENV=production vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "size": "du -sh dist/* && du -sh dist/assets/*",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "browserslist": [
    "Chrome >= 87",
    "Edge >= 87",
    "Firefox >= 78",
    "Safari >= 14"
  ],
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.6.0",
    "dayjs": "^1.11.0",
    "echarts": "^5.5.0",
    "element-plus": "^2.5.0",
    "js-cookie": "^3.0.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-echarts": "^6.6.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^1.6.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^14.0.0",
    "lightningcss": "^1.32.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.3.0",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.4.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  }
}
